rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserProfile(data) {
      return data.userId is string
        && data.userId.size() > 0
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('theme' in data) || (data.theme in ['dark', 'amoled']))
        && (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 200 && (data.favorites.size() == 0 || data.favorites[0] is string)))
        && (!('recentlyViewed' in data) || (data.recentlyViewed is list && data.recentlyViewed.size() <= 30 && (data.recentlyViewed.size() == 0 || data.recentlyViewed[0] is string)))
        && (!('allowAdultChannels' in data) || (data.allowAdultChannels is bool))
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    // User profiles & synced IPTV preferences
    match /users/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'theme', 'favorites', 'recentlyViewed', 'allowAdultChannels', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming());

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'theme', 'favorites', 'recentlyViewed', 'allowAdultChannels', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;
    }
  }
}
